{
  "compilerOptions": {
    // Type checking only, Vite handles the build
    "noEmit": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "paths": { "@/*": ["./src/*"] },
    "types": [
      "node",
      "vite/client",
      "@shoelace-style/shoelace",
      "./node_modules/@shoelace-style/shoelace/dist/types/vue/index.d.ts"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "exclude": ["node_modules", "dist"]
}
